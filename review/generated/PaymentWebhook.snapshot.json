    "approval": null,
    "scope": "Webhook input classification, decision mapping, and ledger-command mapping in the companion example.",
    "boundary": {
      "subject": "PaymentWebhook.Input",
      "description": "Input pairs decoded WebhookPayload with a separate LedgerObservation. alreadyRecorded is not a webhook field.",
      "challenge": "Is the observation from a stable transaction or snapshot? Can concurrent deliveries change it before effects occur?"
    },
    "assumptions": [
      {
        "subject": "PaymentWebhook.Input",
        "statement": "The model receives LedgerObservation.alreadyRecorded separately from the webhook payload; its acquisition and consistency are not modeled."
      }
    ],
    "effectNotes": [
      {
        "subject": "PaymentWebhook.requestLedgerCommand",
        "statement": "A mapping to none means no ledger-command member is requested. It does not prove the handler has no other runtime effects."
      },
      {
        "subject": "PaymentWebhook.decide.firstSuccess",
        "statement": "The companion handler records payment and then enqueues fulfillment; atomicity across those effects is not established. This example has no typed effect contract for that production sequence."
      }
    ],
    "questions": [
      {
        "subject": "PaymentWebhook.Input",
        "question": "What guarantees that alreadyRecorded remains valid until the handler finishes?"
      },
      {
        "subject": "PaymentWebhook.decide.duplicateSuccess",
        "question": "Are duplicate acknowledgments required to be idempotent under concurrent delivery?"
      },
      {
        "subject": "PaymentWebhook.decide.firstSuccess",
        "question": "What recovery behavior is required if recording succeeds and queue publication fails?"
      }
    ],
    "findings": [
